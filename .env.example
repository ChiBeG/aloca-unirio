# Copie para .env e preencha. O arquivo .env NAO deve ser commitado.

# Credenciais OAuth do Google Cloud Console (APIs e servicos > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=false
# true em producao (HTTPS); false para rodar localmente sem HTTPS
DJANGO_SECURE_COOKIES=false

# Enderecos vistos pelo navegador. Use o mesmo host nos dois (ex.: localhost),
# senao o cookie de sessao do Django nao chega ao frontend.
FRONTEND_URL=http://localhost:3002
DJANGO_PUBLIC_URL=http://localhost:8000

# Hosts aceitos pelo Django. Em producao: <dominio>,backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Interface onde as portas 8000 e 3002 sao publicadas. Em producao use 127.0.0.1,
# para que so o proxy reverso alcance os containers.
BIND_ADDRESS=0.0.0.0
